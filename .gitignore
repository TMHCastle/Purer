# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 构建产物（仓库只收发布用的 Purer.exe，不收中间产物）
build/
dist/
*.spec
_pycache_/

# 本地备份 / 截图 / 个人配置
_backup/
_bak*/
_screenshots_*/
*.bak.*
# 默认的已保存缓存目录（Purer 同目录下，v1.1.9 起）
/cache/
# 临时渲染缓存（Purer 同目录，v1.2.6 起；不再放 %TEMP%）
/cache_tmp/
# 自更新留下的旧 exe（Purer.exe.old）；注意 gitignore 不支持行尾注释
*.old
ffmpeg.ini
*.log

# 编辑器
.vscode/
.idea/

# 窄热补丁包（构建产物：python build.py 会生成 Purer-code-<ver>.zip）
Purer-code-*.zip
